{
  "extends": "@astrodx/tsconfig/base.json",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": ["bun", "react", "react-dom"],
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
