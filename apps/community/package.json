{
  "name": "community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite",
    "build": "bun x --bun react-router build",
    "start": "bun ./build/server/index.js",
    "typegen": "react-router typegen",
    "lint": "biome lint",
    "test": "bun test src",
    "check": "bun run lint && bun run typegen && tsc --noEmit && bun test src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/server/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "isbot": "^5.2.2",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "react-router-hono-server": "4.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
