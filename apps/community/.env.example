# 社区站的环境变量。本机开发和 g510 生产都从这份开始：cp .env.example .env，再运行 ops/fill-secrets.sh 补上随机密钥
# （它只打印变量名，不打印值）。之后按各项的说明填写。每一项的用处、谁来填、本机和生产的区别，见 README 的"环境变量"。
# 生产由 compose.yaml 把需要的变量交给各个容器；标着"生产由 compose.yaml 给出"的几项在 g510 上不用填，填了也不生效。

# ---- 站点 ----
# 浏览器看到的站点地址（scheme://host[:port]，不带路径）。本机开发是 Vite 的地址；生产是 https://adxc.saop.cc。
PUBLIC_ORIGIN=http://localhost:5373
# 公开展示在隐私说明中的联系邮箱。生产环境必填，请使用愿意公开的支持邮箱。
PUBLIC_CONTACT_EMAIL=
# 本机开发用 compose.dev.yaml 起的服务（见 README）。生产由 compose.yaml 给出。
DATABASE_URL=postgres://community:community@127.0.0.1:55432/community
REDIS_URL=redis://127.0.0.1:56379
# 以下有默认值，一般不用改。生产镜像里是 0.0.0.0:3000。
# PORT=3000
# HOST=127.0.0.1

# ---- 账号（Better Auth）----
# 签 Cookie 和令牌的密钥，至少 32 个字符，ops/fill-secrets.sh 生成。上线后不能换：换了所有人都要重新登录。
BETTER_AUTH_SECRET=
# Google OAuth 客户端：Google Cloud Console → APIs & Services → Credentials → OAuth client ID，类型选 Web application。
# Authorized redirect URIs：本机 http://localhost:5373/api/auth/callback/google，
# 生产 https://adxc.saop.cc/api/auth/callback/google。生产的客户端建在社区站自己的 Google Cloud 项目里（上线手册）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile。下面是官方测试密钥：任何域名都能用，总是通过。生产换成真实的（Cloudflare 控制台 → Turnstile，
# 域名填 adxc.saop.cc）：真实密钥下，服务端会核对令牌出自本站、用途对得上。
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 本机开发要连 Google（OAuth 换令牌）时，可以在这里设代理，Bun 的 fetch 自己读它；只能是 http(s)://主机:端口。
# 生产不用这一项，用下面的 OUTBOUND_HTTPS_PROXY。
# HTTPS_PROXY=http://127.0.0.1:7890

# ---- 社区站后台（/dash）----
# 管理员的数字公开用户编号，多个用逗号分隔；空值拒绝所有后台访问。不要填写旧短 ID。
# 本轮选定的生产管理员是 1，待发布时配置 COMMUNITY_ADMIN_PUBLIC_IDS=1；此模板默认关闭。
COMMUNITY_ADMIN_PUBLIC_IDS=

# ---- QQ 登录 ----
# console：验证码直接打印在终端（只能本机用，生产环境拒绝启动）；napcat：通过 NapCat 机器人私聊发送。
# 生产由 compose.yaml 定为 napcat。
QQ_SENDER=console
# 验证码在 Redis 里只存 HMAC 值，这是它的密钥，至少 32 个字符，ops/fill-secrets.sh 生成。
QQ_CODE_HMAC_KEY=
# NapCat 的访问令牌（HTTP 和 WebSocket 共用），至少 32 个字符，ops/fill-secrets.sh 生成。生产里 compose.yaml 还用它
# 写 NapCat 的配置（src/server/napcat/write-onebot-config.ts），两边自然一致。
NAPCAT_ACCESS_TOKEN=
# 机器人的 QQ 号：社区站专用的小号，和 astrbot 用的不是同一个。生产必填；本机只在 QQ_SENDER=napcat 时需要。
NAPCAT_BOT_QQ=
# 本机接真的 NapCat 时（QQ_SENDER=napcat）才需要。生产由 compose.yaml 给出容器网络里的地址。
# NAPCAT_HTTP_URL=http://127.0.0.1:3000
# NAPCAT_WS_URL=ws://127.0.0.1:3001

# ---- 统计（Umami）----
# 在 Umami 后台建好网站以后才有的网站 ID（UUID）。空着时统计整个关着：页面不放统计脚本，/_s/* 返回 404。
UMAMI_WEBSITE_ID=
# Umami 的内部地址，/_s/* 转发到这里；设了 UMAMI_WEBSITE_ID 时必填。生产由 compose.yaml 给出（http://umami:3000）。
# UMAMI_INTERNAL_URL=http://127.0.0.1:3000

# ---- 只给 g510 上的 compose.yaml 用（本机开发用不到）----
# NapCat WebUI 的登录令牌：第一次启动时写进它的配置，以后在 WebUI 里改。ops/fill-secrets.sh 生成。
NAPCAT_WEBUI_TOKEN=
# PG 超级用户 community 的密码。数据库第一次启动时写进库里，之后改这里就连不上了。ops/fill-secrets.sh 生成。
POSTGRES_PASSWORD=
# Umami 的数据库角色 umami 的密码，同样只在数据库第一次启动时生效（ops/postgres-init/10-umami.sh）。
UMAMI_DB_PASSWORD=
# Umami 自己的密钥（它的 APP_SECRET）。ops/fill-secrets.sh 生成。
UMAMI_APP_SECRET=
# web 容器访问 Google 用的代理，g510 上是 http://host.docker.internal:20171（宿主机上 v2rayA 的 HTTP 入口）。
# 空着就不用代理。不叫 HTTPS_PROXY：执行 docker compose 的 shell 里要是设了同名变量，会盖过这里的值。
OUTBOUND_HTTPS_PROXY=
# 备份（ops/backup/backup.sh，每天 03:30）：restic 仓库在宿主机上的目录（绝对路径，最好和 Docker 的数据不在同一块
# 硬盘上），和仓库的密码。密码同时存进密码管理器：丢了它，备份就再也打不开。都由用户自己填。
BACKUP_REPO_DIR=
RESTIC_PASSWORD=

# Storage credentials are generated locally; only the matching role receives them.
STORAGE_INTERNAL_MEDIA_SECRET=
STORAGE_WEB_ACCESS_KEY_ID=
STORAGE_WEB_SECRET_ACCESS_KEY=
STORAGE_MEDIA_ACCESS_KEY_ID=
STORAGE_MEDIA_SECRET_ACCESS_KEY=
STORAGE_CONTROL_ACCESS_KEY_ID=
STORAGE_CONTROL_SECRET_ACCESS_KEY=
STORAGE_BACKUP_ACCESS_KEY_ID=
STORAGE_BACKUP_SECRET_ACCESS_KEY=

# Provisioned private disk filesystem, <=2 GiB, never a plain unbounded directory or tmpfs.
STORAGE_MEDIA_SCRATCH_DIR=
# Required verified upper limits for each pg_dump (bytes); no guessed zero/default.
STORAGE_COMMUNITY_DUMP_BOUND=
STORAGE_UMAMI_DUMP_BOUND=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# 可选 AWMC OAuth：回调 https://adxc.saop.cc/api/auth/callback/awmc；同时填写才启用。
AWMC_CLIENT_ID=
AWMC_CLIENT_SECRET=
