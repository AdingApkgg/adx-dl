# 浏览器看到的站点地址（scheme://host[:port]，不带路径）。本机开发是 Vite 的地址。
PUBLIC_ORIGIN=http://localhost:5373
# 本机开发用 compose.dev.yaml 起的服务（见 README）。
DATABASE_URL=postgres://community:community@127.0.0.1:55432/community
REDIS_URL=redis://127.0.0.1:56379
# 以下有默认值，一般不用改。
# PORT=3000
# HOST=127.0.0.1

# ---- 账号（Better Auth）----
# 签 Cookie 和令牌的密钥，至少 32 个字符：openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth 客户端：Google Cloud Console → APIs & Services → Credentials → OAuth client ID，
# 类型选 Web application，Authorized redirect URIs 填 http://localhost:5373/api/auth/callback/google
# （线上再加一条 https://<主站域名>/api/auth/callback/google）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile。下面是官方测试密钥：任何域名都能用，总是通过。线上换成真实的密钥。
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- QQ 登录 ----
# console：验证码直接打印在终端（只能本机用，生产环境拒绝启动）；napcat：通过 NapCat 机器人私聊发送。
QQ_SENDER=console
# 验证码在 Redis 里只存 HMAC 值，这是它的密钥，至少 32 个字符：openssl rand -base64 32
QQ_CODE_HMAC_KEY=
# 以下四项只在 QQ_SENDER=napcat 时需要。访问令牌至少 32 个字符，和 NapCat 配置里的 token 一致。
# NAPCAT_HTTP_URL=http://napcat:3000
# NAPCAT_WS_URL=ws://napcat:3001
# NAPCAT_ACCESS_TOKEN=
# NAPCAT_BOT_QQ=
