/node_modules

# react-router build output (client SPA bundle + the prerender-only server build)
/build

# bun build:server output
/dist

# react-router typegen (./+types/*, rootDirs target in tsconfig.json)
/.react-router

# misc
.DS_Store
*.tsbuildinfo

# env files (can opt-in for committing if needed)
.env*
