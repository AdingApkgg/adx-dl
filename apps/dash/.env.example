# Cloudflare Access —— 在 Zero Trust 控制台建好应用后才能拿到这两个值。
# TEAM_DOMAIN 是团队域名，末尾不要带斜杠；AUD 是该应用的 Application Audience Tag。
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# GitHub App —— 装到 AdingApkgg/adx-dl，权限 Contents RW / Actions RW /
# Pull requests RW / Metadata R。私钥写成单行，换行用字面 \n 转义。
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

GITHUB_REPO_OWNER=AdingApkgg
GITHUB_REPO_NAME=adx-dl

# 可选
PORT=3000
DASH_CLIENT_ROOT=./build/client
