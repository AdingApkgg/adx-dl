{
  "name": "dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:server": "bun build src/server/main.ts --target=bun --outfile=dist/server.js",
    "start": "bun run src/server/main.ts",
    "test": "bun test",
    "typegen": "react-router typegen",
    "lint": "eslint --cache",
    "check": "bun run lint && bun run typegen && tsc --noEmit && bun test"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "hono": "^4.13.9",
    "isbot": "^5.2.2",
    "jose": "^6.2.12",
    "octokit": "^5.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "8.4.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
